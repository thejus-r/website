---
import BlogCard from "@components/BlogCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
const posts = await getCollection("blog");
---

<BaseLayout>
  <main class="pt-16 p-4 max-w-[680px] md:mx-auto">
    <h2 class="text-sm text-neutral-600 font-semibold mt-4 mb-4">
      // writings
    </h2>
    <ul class="text">
      {
        posts.map((post) => (
          <li>
            <BlogCard post={post} />
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>
