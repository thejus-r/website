---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
const posts = await getCollection('blog')
---

<BaseLayout>
  <div>
    <h1>My Posts</h1>
    <ul>
    {posts.map(post => (
      <li><a href={`/blog/${post.id}`}>{post.data.title}</a></li>
    ))}
    </ul>
  </div>
</BaseLayout>

