---
import { getEntry } from "astro:content";
import { Image } from "astro:assets"
import Tag from "../components/tag.astro";
import Layout from "../layouts/base-layout.astro";

const socials = await getEntry("socials", "links")
--- 

<Layout title="Thejus Rajendran">
  <div class="flex flex-col grow p-8 md:p-12">
    <div class="flex flex-col gap-4 text-pretty leading-8">
      <h1 class="font-serif text-5xl">Thejus Rajendran</h1>
      <span class="font-mono text-neutral-500">{"<Software Engineer/>"}</span>
      <div class="text-lg mt-4 flex text-neutral-400 flex-col gap-4 leading-8">
        <p>
          I'm also a creative and used to work as a product designer for a
          Design Studio in Bengaluru, but I've gladly left that life far behind
          me.
        </p>
        <p>
          I love building things, I wrote my first line of code in middle school
          making a pizza ordering app in QuickBASIC.
        </p>
        <p>Currently I am working on Raven, which is a SaSS project of mine.</p>
        <p>I am highly driven by curiosity by just asking "how stuff works".</p>
      </div>
    </div>
    <div class="mt-8">
      <div class="flex items-center gap-8">
        <h3 class="font-serif text-2xl">My Stack</h3>
        <span class="block border border-neutral-700 grow"></span>
      </div>
      <div class="flex gap-2 mt-4">
        <Tag> React </Tag>
        <Tag> TailwindCSS </Tag>
        <Tag>Typescript</Tag>
        <Tag>Javascript</Tag>
      </div>
    </div>
    <div class="mt-8">
      <div class="flex items-center gap-8">
        <h3 class="font-serif text-2xl">Social Profiles</h3>
        <span class="block border border-neutral-700 grow"></span>
      </div>
      <div class="flex fill-white gap-2 mt-4">
        {socials?.data.map((link) => 
        <a class="hover:brightness-125" href={link.link} target="_blank">
          <Tag>
            <Image class="w-5 h-5 fill-amber-400 text-neutral-600 stroke-white" slot="icon" src={link.icon} alt="icon"/>
            {link.name} 
          </Tag>
        </a>
        )}
      </div>
    </div>
  </div>
</Layout>
