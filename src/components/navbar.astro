---
const { pathname } = Astro.url;

const isActive = (href: string) => {
  return pathname == href;
};

const isExternalLink = (href: string) => {
  return !(href.startsWith("/") || href.startsWith("#"));
};

const links = [
  {
    href: "/",
    name: "about",
  },
  {
    href: "/blog",
    name: "blog",
  },
];
---

<nav class="py-5 px-12">
  <ul class="flex gap-4 justify-start">
    {
      links.map(({ href, name }) => (
        <li>
          <a
            class={`pb-1 ${isActive(href) ? "text-neutral-100 border-b-2" : "text-neutral-500"}`}
            href={href}
            target={isExternalLink(href) ? "_blank" : ""}
          >
            {name}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
