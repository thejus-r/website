  class="flex flex-col w-64 gap-1 bg-neutral-100 border-r border-r-neutral-200 h-full justify-center p-4"
>
  <NavLink iconSrc="./images/icon/home.svg" href="/"> Home </NavLink>
  <NavLink iconSrc="./images/icon/writing.svg" href="/blog"> Writing </NavLink>
  <NavDivider> Projects </NavDivider>
  <NavLink iconSrc="./images/icon/bloom-book.svg" href="/bloom-book">
    Bloom Book
  </NavLink>
  <NavLink iconSrc="./images/icon/better-resume.svg" href="/better-resume">
    Better Resume
  </NavLink>
  <NavDivider> Find Me at</NavDivider>
  <NavLink externalLink target="_blank" href="/facebook">LinkedIn</NavLink>
  <NavLink target="_blank" href="/github">Github</NavLink>
  <NavLink target="_blank" href="https://www.x.com">X / Twitter</NavLink>
</nav>
