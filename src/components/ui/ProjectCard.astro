---
type Props = {
    name: string;
    href: string;
    date: string;
};

const { name, href, date } = Astro.props;
---

<a href={href} class="flex gap-2 w-full items-center group">
    <span
        class="text-neutral-800 group-hover:text-blue-600 group-hover:underline underline-offset-2 block"
        >{name}</span
    >
    <hr class="flex-1 border border-neutral-100" />
    <span class="font-mono text-sm text-neutral-400 block">{date}</span>
</a>
