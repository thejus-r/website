---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a"> & {
  iconSrc?: string;
  externalLink?: boolean;
};
const { href, iconSrc, externalLink, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");
const subpath = pathname.match(/[^\/]+/g);
const isActive = href === pathname || href == "/" + (subpath?.[0] || "");
---

<a
  href={href}
  class:list={[
    "rounded-xl w-full text-sm bg-neutral-100 text-neutral-800 p-2 flex gap-1.5 hover:brightness-95",
    { "bg-white hover:brightness-100": isActive },
  ]}
  {...props}
>
  {iconSrc && <img src={iconSrc} alt="icon" width="16" />}
  <slot class="w-full" />
  {
    externalLink && (
      <img
        src="./images/icon/external-link.svg"
        alt="external link icon"
        width="16"
      />
    )
  }
</a>
